# ColabSign: variáveis do colab/compose.yml. Copie para colab/.env (fora do git).
# Gere cada segredo com: openssl rand -hex 32

# Endereço público (HTTPS) do site.
APP_URL=https://sign.colaborato.rio
APP_PORT=3000

POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
# Fecha /api/internal/* e é usado pelo serviço scheduler.
RETENTION_JOB_SECRET=
# Pedido na página /setup do primeiro acesso.
SETUP_TOKEN=

# E-mail: vazio = Resend (precisa de RESEND_API_KEY e domínio verificado).
# Conta Resend com o domínio colaborato.rio verificado (SPF/DKIM no
# Cloudflare); chave com permissão "Full access" (o app confere o domínio).
EMAIL_DRIVER=
RESEND_API_KEY=
RESEND_REGION=sa-east-1
# Remetente (o nome aparece para o signatário) e para onde vão as respostas.
RESEND_FROM_EMAIL=ColabSign <assinar@colaborato.rio>
SUPPORT_EMAIL=contato@colaborato.rio   # confirmar qual caixa recebe as respostas

# Login pelo ColabAuth (WorkOS AuthKit), ver COLABSIGN.md.
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_NAME=ColabAuth
# off = só pelo ColabAuth; os e-mails abaixo guardam a senha para emergência.
PASSWORD_SIGN_IN=
PASSWORD_SIGN_IN_ALLOWED_EMAILS=

# Limpeza diária (UTC) e fila de webhooks.
RETENTION_AT_UTC=09:00
WEBHOOKS_EVERY_MINUTES=5
