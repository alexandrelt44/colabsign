  "Signed by ${signer.name} | ${signedAt} | Meaning: ${SIGNATURE_MEANING_DETAILS[signer.signatureMeaning].label}": "Assinado por ${signer.name} | ${signedAt} | Significado: ${SIGNATURE_MEANING_DETAILS[signer.signatureMeaning].label}",
  "This site has no record of this exact file. It may be an unsigned copy, have been changed or saved again by another program, come from somewhere else, or belong to a record that has been removed. Check the digital seal in a PDF reader, or ask the sender for their copy.": "Este site não tem registro deste arquivo exato. Ele pode ser uma cópia sem assinatura, ter sido alterado ou salvo de novo por outro programa, ter vindo de outro lugar ou pertencer a um registro que foi apagado. Confira o selo digital num leitor de PDF ou peça a via de quem enviou.",
  "No match.": "Nenhum registro encontrado.",
  "signed document": "documento assinado",
  "audit certificate": "certificado de auditoria",
  "This file is unchanged. It is the ${fileLabel} this site produced for \\u201c${result.title}\\u201d.": "Este arquivo não foi alterado. É o ${fileLabel} que este site gerou para \\u201c${result.title}\\u201d.",
  "This file is unchanged. It is the ${fileLabel} this site produced.": "Este arquivo não foi alterado. É o ${fileLabel} que este site gerou.",
